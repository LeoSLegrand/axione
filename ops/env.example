# Copy to /opt/axione/<environment>/<environment>.env on the server. Never committed.
POSTGRES_PASSWORD=change-me
# Domain name, or a name derived from the server IP such as 203-0-113-10.sslip.io
SITE_ADDRESS=localhost
# Registry and owner of the images (lowercase), the tag is passed by the deploy workflow
IMAGE_REPOSITORY=ghcr.io/owner
HTTP_PORT=80
HTTPS_PORT=443
