{
  "name": "axione",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.11",
  "engines": {
    "node": ">=24.0.0 <27"
  },
  "scripts": {
    "dev": "pnpm --filter @axione/web dev",
    "build": "pnpm --filter @axione/web build",
    "lint": "eslint .",
    "check:boundaries": "depcruise apps packages --config .dependency-cruiser.cjs",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @axione/db db:generate",
    "db:migrate": "pnpm --filter @axione/db db:migrate",
    "db:deploy": "pnpm --filter @axione/db db:deploy",
    "db:seed": "pnpm --filter @axione/db db:seed",
    "start": "pnpm --filter @axione/web start"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "dependency-cruiser": "catalog:",
    "eslint": "catalog:",
    "eslint-config-next": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-jsx-a11y": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
